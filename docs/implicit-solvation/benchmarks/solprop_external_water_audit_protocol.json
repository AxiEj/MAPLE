{
  "schema_version": 1,
  "protocol_id": "maple-route1-solprop-external-water-audit-v1",
  "claim_scope": "Pre-registered, label-free SolProp external-water source audit. This workflow reads only solvent identity, solute identity, and measurement-source columns; excludes any conservative FreeSolv connectivity or provenance overlap; and selects neutral, connected, closed-shell organic candidates in the declared Route 1 element domain. It performs neither energy calculation nor experimental-label scoring.",
  "route1_boundary": {
    "name": "Additive fixed-charge PB/GB implicit solvation",
    "formula": "E_solution(R)=E_MLIP,gas(R)+G_polar(R,q_fixed)+G_nonpolar(R)",
    "gas_phase_mm_energy": false,
    "hydration_label_residual": false,
    "mlip_retraining": false,
    "fixed_charge": "AM1-BCC"
  },
