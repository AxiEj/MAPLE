    },
    "termination_classes": [
      "converged",
      "bounded_nonconvergence",
      "validation_failure",
      "execution_failure"
    ]
  },
  "policy": {
    "output_directory_must_be_new": true,
    "source_must_remain_unchanged": true,
    "no_threshold_increase_after_failure": true,
    "no_automatic_model_fixture_or_device_substitution": true,
    "caps_are_not_convergence": true,
    "bounded_nonconvergence_is_execution_not_numerical_success": true,
