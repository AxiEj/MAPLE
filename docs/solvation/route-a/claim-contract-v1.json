  "route2_superiority_metric": {
    "name": "route2-superiority-demonstrated",
    "required_fields": [
      "route2_delta_ci_95_upper",
      "route2_delta_ci_95_lower",
      "route2_fail_count",
      "route2_abstain_count",
      "route2_d_i_abs_error",
      "route2_sample_count",
      "route2_paired_rows",
      "route2_paired_rows_hash",
      "route2_bootstrap_indices",
      "route2_bootstrap_indices_hash"
    ],
    "evaluator": {
      "op": "and",
      "terms": [
        {
          "field": "route2_delta_ci_95_upper",
          "op": "lt",
          "value": 0.0
        },
        {
          "field": "route2_fail_count",
          "op": "eq",
          "value": 0
        },
        {
          "field": "route2_abstain_count",
          "op": "eq",
          "value": 0
        }
      ]
    },
    "definition": "For each matched molecule i, d_i = |err_A(i)| - |err_route2(i)|. The CI upper bound on mean(d_i) must be strictly less than 0.0; no fail-counts or abstentions allowed in the final superiority claim.",
    "formula": "d_i = abs(err_A(i)) - abs(err_R2(i))",
    "raw_evidence_rule": "recompute d_i, sample count, failure/abstention counts and percentile CI from hash-bound paired rows and bootstrap indices; summaries must match"
  },
  "hash_canonicalization": "sort_keys=True,separators=(',',':')",
  "notes": "Typed status lattice with production promotion capped at engineering-ready until production registries and runtime stage validators exist; higher-status known-answer tests require explicit test-only opt-in.",
