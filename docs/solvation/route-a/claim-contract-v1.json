      "frozen_absolute_rows_hash"
    ],
    "thresholds": {
      "mae_max_kcal": 1.0,
      "rmse_max_kcal": 1.5,
      "abs_mse_max_kcal": 0.5,
      "fail_count": 0,
      "abstain_count": 0
    },
    "evaluator": {
      "op": "and",
      "terms": [
        {
          "field": "frozen_mae_kcal",
          "op": "le",
          "value": 1.0
        },
        {
          "field": "frozen_rmse_kcal",
          "op": "le",
          "value": 1.5
        },
        {
          "field": "frozen_mse_kcal",
          "op": "abs_le",
          "value": 0.5
        },
        {
          "field": "frozen_fail_count",
          "op": "eq",
          "value": 0
        },
        {
          "field": "frozen_abstain_count",
          "op": "eq",
          "value": 0
        }
      ]
    },
    "definition": "Derived from the frozen untouched holdout only; all three absolute-error thresholds and zero failure/abstention counts must pass.",
    "raw_evidence_rule": "recompute errors, MAE, RMSE, MSE, failures and abstentions from hash-bound per-molecule rows; summaries must match"
  },
  "material_partition_bias": {
    "gate_field": "material_partition_bias_passed",
    "direct_boolean_gate_input_allowed": false,
    "units": "kcal/mol",
    "required_fields": [
