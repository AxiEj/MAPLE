    "symmetry": "RT ln(n!)",
    "release": "sum_i DeltaG_release(i)",
    "outer_cycle": "DeltaG_outer(XW_n)-n*DeltaG_outer(W)",
    "row": "A_n=labeled_association+density_volume+RT ln(n!)+release+outer_cycle",
