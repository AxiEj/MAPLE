      "conditioning_measure_id",
      "temperature_k",
      "ensemble",
      "pressure_bar",
      "boundary_conditions"
    ],
    "runtime_identity_validation": [
      "solvent calculator maple_hamiltonian_hash equals water_hamiltonian_hash",
      "canonical oxygen atom index map equals oxygen_atom_map_hash",
      "canonical runtime periodic cell equals cell_hash"
