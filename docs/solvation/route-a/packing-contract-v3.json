    "freeze_before_real_v3_replicas": true
  },
  "analysis": {
    "primary_estimator": "MBAR free-energy difference at explicit target and full-field indices",
    "mandatory_cross_check": "target-state reweighted expectation of product_j(1-b_j)",
    "hard_empty_indicator_role": "diagnostic-only",
    "bar_mbar_agreement_required": true,
    "neighbor_overlap_connectivity_required": true,
    "target_and_full_effective_sample_size_required": true,
