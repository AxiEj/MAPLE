  },
  "qct_conditioning": {
    "identity": "cluster-qct-multistate",
    "packing_probability": {
      "symbol": "p_0(lambda_s)",
      "system": "pure_bulk_water",
      "required": true,
      "estimator": "staged-soft-cavity-free-energy",
      "same_observation_volume_required": true
    },
    "n0_state": {
      "conditioned_empty_shell_required": true,
      "ordinary_bare_route2_outer_allowed": false,
      "common_construction_rule_required": true
    },
    "cross_checks": [
      "direct-qct-ln-x0-minus-ln-p0-plus-conditioned-long-range",
      "fixed-n-with-p_X(n)"
    ],
    "formulas": {
      "hydration_free_energy": "mu_X_ex = -RT ln p_0(lambda_s) - RT ln sum_n exp[-beta A_n_tilde(lambda_s)]",
      "conditioned_weight": "A_n_tilde(lambda_s) = -RT ln[K_n_tilde(lambda_s) rho_W^n]",
      "direct_qct": "beta mu_X_ex = ln x_0(lambda_s) - ln p_0(lambda_s) + beta mu_LR(lambda_s)",
      "fixed_n": "mu_X_ex = -RT ln[K_n^(0) rho_W^n] + RT ln p_X(n;lambda_s) + mu_XWn_ex - n mu_W_ex"
    }
  },
